# Arduino as a component
CONFIG_AUTOSTART_ARDUINO=y
CONFIG_FREERTOS_HZ=1000
CONFIG_ARDUINO_LOOP_STACK_SIZE=16384

# ESP32-S3-DevKitC-1 N16R8: 16 MB quad flash, 8 MB octal PSRAM
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y

# Logs on the UART port; the native USB port is either the Stream Deck's USB host or, with a
# computer attached, a USB-Serial-JTAG port (which gets the logs too)
CONFIG_ESP_CONSOLE_UART_DEFAULT=y

# USB host FIFOs biased towards IN packets (up to 600 bytes instead of 408): the MK.2 Scissor
# has a 512-byte interrupt IN endpoint even at full speed. Periodic OUT drops to 128 bytes;
# StreamDeck::shrinkOversizedOut() handles its 1024-byte OUT endpoint.
CONFIG_USB_HOST_HW_BUFFER_BIAS_IN=y

# Image cache file names are "/deck/img/<32 hex>.img"
CONFIG_LITTLEFS_OBJ_NAME_LEN=64

# The project lives in a path with spaces (iCloud Drive); -fmacro-prefix-map can't take one
CONFIG_COMPILER_HIDE_PATHS_MACROS=n

# NVS is set up on the main task (initArduino(), before setup()); with encrypted NVS that
# includes finishing an interrupted move to encryption (SecureNVS). The task ends once the
# loop task starts, so its stack costs nothing afterwards.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# OTA updates: a new image must mark itself valid (after authenticating with its bridge) or
# the bootloader rolls back to the previous one
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# Stack smashing protection for functions with arrays on the stack (the network parsers)
CONFIG_COMPILER_STACK_CHECK_MODE_NORM=y

# The loop task is subscribed to the task watchdog (enableLoopWDT()); a loop pass stuck for
# this long restarts the device
CONFIG_ESP_TASK_WDT_TIMEOUT_S=20
CONFIG_ESP_TASK_WDT_PANIC=y
