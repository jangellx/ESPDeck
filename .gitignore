# macOS and iCloud Drive
.DS_Store
# Anything named *.nosync stays out of iCloud: the git data (.git.nosync) and
# ESPDeck Device/managed_components.nosync (managed_components is a symlink to it).
*.nosync

# Built firmware for the web installer; the release workflow builds and deploys it.
web/firmware/*.bin

# The firmware signing key lives only in the FIRMWARE_SIGNING_KEY secret. Never commit it;
# these catch the usual names for a copy of it.
*.key
*private*.pem
firmware_signing_key.pem
